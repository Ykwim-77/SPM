{
  "expo": {
    "name": "Saúde na Palma da Mão",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saudepalma",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.patientmobileapp.gcoq20",
      "infoPlist": {
        "NSCameraUsageDescription": "Autorize para registrar a foto do medicamento",
        "NSPhotoLibraryUsageDescription": "Autorize para selecionar sua foto de perfil"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0066CC"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.patientmobileapp.gcoq20",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0066CC"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autorize para registrar a foto do medicamento",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorize para selecionar sua foto de perfil"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
